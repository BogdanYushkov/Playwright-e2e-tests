{
  "name": "playwright-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end test suite for saucedemo.com built with Playwright, Page Object Model and Allure reporting",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium-auth --project=chromium-noauth",
    "test:firefox": "playwright test --project=firefox-auth --project=firefox-noauth",
    "test:webkit": "playwright test --project=webkit-auth --project=webkit-noauth",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "allure-commandline": "^2.33.0",
    "allure-playwright": "^2.15.1"
  }
}
